# ─────────────────────────────────────────────────────────────
# Family Finance App — Environment Variables
# Salin file ini ke .env dan sesuaikan nilainya
# ─────────────────────────────────────────────────────────────

# Database PostgreSQL
DB_USER=finance_user
DB_PASSWORD=finance_pass
DB_NAME=finance_db

# Port yang ter-expose ke host
# Hanya port 8080 (client) yang perlu diakses dari browser
# CLIENT_PORT=8080

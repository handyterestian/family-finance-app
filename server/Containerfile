# ─────────────────────────────────────────────────────────────
# Stage 1: builder — generate protobuf stubs and compile the gRPC server
# ─────────────────────────────────────────────────────────────
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache protobuf

RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.34.1 && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.3.0

ENV PATH="/go/bin:${PATH}"

WORKDIR /build

COPY proto/ ./proto/
COPY server/ ./server/

RUN mkdir -p server/generated && \
    protoc \
      --proto_path=proto \
      --go_out=server/generated \
      --go_opt=paths=source_relative \
      --go-grpc_out=server/generated \
      --go-grpc_opt=paths=source_relative \
      proto/finance.proto

WORKDIR /build/server

RUN go mod tidy && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /app/server .

# ─────────────────────────────────────────────────────────────
# Stage 2: runtime — minimal image
# ─────────────────────────────────────────────────────────────
FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY --from=builder /app/server ./server

EXPOSE 50051

ENTRYPOINT ["/app/server"]
